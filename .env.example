# PostgreSQL
POSTGRES_DB=warehouse
POSTGRES_USER=warehouse_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=admin123

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# App
SERVER_PORT=8080
JWT_SECRET=change_me_to_long_random_secret_at_least_256_characters_long_to_ensure_strong_encryption_for_jwt_tokens

# Spring profile: stg | dev
SPRING_PROFILES_ACTIVE=stg

# Consul for stg (write "localhost" in case .env.local / dev)
CONSUL_HOST=consul

# Tempo
OTLP_TRACING_ENDPOINT=http://tempo:4318/v1/traces

# Sampling probability (1.0 = 100% traces). Use 0.1-0.5 for production.
TRACING_SAMPLING_PROBABILITY=0.5

# ============================================
# LOKI
# ============================================

# Enable automatic deletion of old logs
RETENTION_DELETES_ENABLED=true

# Log retention period (168h = 7 days, 720h = 30 days)
RETENTION_PERIOD=168h

# Maximum number of streams (labels) per tenant
MAX_STREAMS_PER_USER=10000

# Maximum number of entries returned per query
MAX_ENTRIES_LIMIT=5000

# Reject logs older than retention period
REJECT_OLD_SAMPLES=true

# Query timeout
QUERY_TIMEOUT=30s

# Maximum concurrent queries per tenant
MAX_OUTSTANDING=1000

# Compaction interval (how often to compact and clean old data)
COMPACTION_INTERVAL=10m

# Backup settings
BACKUP_RETENTION_COUNT=10
BACKUP_CRON=0 2 * * *

# Webhook для алертов при падении бэкапа (оставь пустым, чтобы отключить).
# Принимает любой URL с POST + JSON. Примеры:
#   Slack:    https://hooks.slack.com/services/...
#   Telegram: https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<ID>
#   Generic:  https://webhook.site/... (для тестов)
WEBHOOK_URL=

# Dead man's switch — URL для HTTP ping после УСПЕШНОГО бэкапа.
# Если ping не приходит вовремя, сервис сам алертит (например Healthchecks.io).
# Оставь пустым, чтобы отключить.
HEALTHCHECK_URL=

# Шифрование дампов: passphrase для AES-256 через gpg (оставь пустым = без шифрования)
BACKUP_ENCRYPT_KEY=

# Offsite backup: S3 bucket и endpoint (оставь пустым = без загрузки)
# AWS credentials нужны только если S3_BUCKET задан
S3_BUCKET=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Timezone для cron-бэкапов (например: Europe/Moscow, Europe/London, America/New_York)
TZ=Europe/Moscow